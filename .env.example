# 云端大模型配置，兼容 OpenAI-style chat/completions 或 responses 接口
# DeepSeek 官方 OpenAI ChatCompletions 示例：
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash
# LLM_WIRE_API=chat
# LLM_FULL_URL=false
# LLM_THINKING=disabled
# LLM_REASONING_EFFORT=
# LLM_API_KEY=sk-...
#
# 如需 DeepSeek 推理模式，可设置：
# LLM_THINKING=enabled
# LLM_REASONING_EFFORT=high
#
# 如果中转站走 Responses API：
# LLM_BASE_URL=https://example.com/v1
# LLM_MODEL=gpt-5.5
# LLM_WIRE_API=responses
# LLM_FULL_URL=false
# LLM_REASONING_EFFORT=high
#
# 如果中转站后台提示“完整 URL，不拼接路径”，设置：
# LLM_FULL_URL=true

LLM_BASE_URL=
LLM_MODEL=
LLM_WIRE_API=chat
LLM_FULL_URL=false
LLM_THINKING=
LLM_REASONING_EFFORT=
LLM_API_KEY=

# ============================================================
#  认证 / 短信 / 微信 配置（由 backend/auth.py 自动加载）
#  详细教程见 docs/auth-third-party-setup.md
# ============================================================

# ── JWT 密钥（务必改成随机长字符串，生产环境不要用默认值）──
# JWT_SECRET=please-change-me-to-a-long-random-string
# JWT_EXPIRES_SECONDS=86400

# ── 短信验证码 ──────────────────────────────────────────────
# 服务商：aliyun（阿里云）/ tencent（腾讯云）/ 留空 = 调试模式
# 调试模式下不会真正发短信，验证码固定为 DEBUG_SMS_CODE（默认 123456），前端自动填入
SMS_PROVIDER=

# 调试验证码（仅在未配置短信服务商时生效）
# DEBUG_SMS_CODE=123456

# 阿里云短信（SMS_PROVIDER=aliyun 时必填）
# 获取：阿里云控制台 → 短信服务 → AccessKey（ID/Secret）、签名、模板
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=你的签名
# ALIYUN_SMS_TEMPLATE_CODE=SMS_1234567890

# 腾讯云短信（SMS_PROVIDER=tencent 时必填）
# 获取：腾讯云控制台 → 短信 → API 密钥、SDKAppID、签名、模板
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_SMS_SDK_APP_ID=1400123456
# TENCENT_SMS_SIGN_NAME=你的签名
# TENCENT_SMS_TEMPLATE_ID=1234567

# ── 微信开放平台（网站应用登录）────────────────────────────
# 获取：https://open.weixin.qq.com → 网站应用 → AppID/AppSecret（需企业认证 + 应用审核）
# 同时需把网站域名配置到授权回调域
# WECHAT_APPID=
# WECHAT_SECRET=
