# 云端大模型配置，兼容 OpenAI-style chat/completions 或 responses 接口
# DeepSeek 官方 OpenAI ChatCompletions 示例：
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash
# LLM_WIRE_API=chat
# LLM_FULL_URL=false
# LLM_THINKING=disabled
# LLM_REASONING_EFFORT=
# LLM_API_KEY=sk-...
#
# 如需 DeepSeek 推理模式，可设置：
# LLM_THINKING=enabled
# LLM_REASONING_EFFORT=high
#
# 如果中转站走 Responses API：
# LLM_BASE_URL=https://example.com/v1
# LLM_MODEL=gpt-5.5
# LLM_WIRE_API=responses
# LLM_FULL_URL=false
# LLM_REASONING_EFFORT=high
#
# 如果中转站后台提示“完整 URL，不拼接路径”，设置：
# LLM_FULL_URL=true

LLM_BASE_URL=
LLM_MODEL=
LLM_WIRE_API=chat
LLM_FULL_URL=false
LLM_THINKING=
LLM_REASONING_EFFORT=
LLM_API_KEY=
